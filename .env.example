# Copy this file to .env and fill in whatever you have.
# Everything here is optional — leave it blank and the app runs in
# "test mode": texts/emails are logged to the terminal instead of sent.

# Optional: Google Places key for more accurate address autocomplete on the
# catering form. Without it, the free Photon (OpenStreetMap) service is used.
GOOGLE_MAPS_API_KEY=

# Twilio — turns on real "order received" text messages.
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend — turns on real order-receipt and catering-followup emails.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@clesmashburgers.com

# Clover — pushes paid orders/catering bookings into your restaurant's
# Clover account so staff see them on the register/KDS and a kitchen
# ticket can print. Get both from dashboard.clover.com under
# Setup > API Tokens (generating a token there also shows your
# Merchant ID). Leave blank and orders just aren't pushed — customers
# still get their normal confirmation either way.
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
# Set to "true" to test against Clover's sandbox instead of your real
# live account while you're getting this set up.
CLOVER_SANDBOX=

# Private admin dashboard at /admin — ONE login. Until BOTH are set the
# dashboard stays locked (nobody can log in). Pick a long password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: where customer replies to emails sent from the dashboard go
# (defaults to the first CATERING_NOTIFY_EMAILS address).
ADMIN_REPLY_TO=

PORT=3000

# Who gets the full catering booking form when someone books (comma-separated).
# Defaults to operations@clesmashburgers.com and bakarilewis@gmail.com.
CATERING_NOTIFY_EMAILS=operations@clesmashburgers.com,bakarilewis@gmail.com
