# Copy this file to .env and fill in whatever you have.
# Everything here is optional — leave it blank and the app runs in
# "test mode": payments are simulated (no real charge) and texts/emails
# are logged to the terminal instead of sent.

# Stripe — turns on real payment collection at checkout.
# Get a test-mode key from https://dashboard.stripe.com/test/apikeys
# (it will start with sk_test_...). Switch to a live key (sk_live_...)
# only when you're ready to take real payments.
STRIPE_SECRET_KEY=

# Twilio — turns on real "order received" text messages.
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend — turns on real order-receipt and catering-followup emails.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@clesmashburgers.com

# Kitchen dashboard passcode (protects /#/kitchen). Leave this blank while
# you're just testing locally — the board will be open with no login.
# Set a real value before this app is reachable from outside your machine.
KITCHEN_PASSWORD=

PORT=3000
