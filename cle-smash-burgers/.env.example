# Copy this file to .env and fill in whatever you have.
# Everything here is optional — leave it blank and the app runs in
# "test mode": payments are simulated (no real charge) and texts/emails
# are logged to the terminal instead of sent.

# Stripe — turns on real payment collection at checkout.
# Get a test-mode key from https://dashboard.stripe.com/test/apikeys
# (it will start with sk_test_...). Switch to a live key (sk_live_...)
# only when you're ready to take real payments.
STRIPE_SECRET_KEY=
# The matching publishable key (starts with pk_test_... or pk_live_...,
# same Dashboard page as above) — safe to expose to the browser, that's
# what it's designed for. The payment form (card entry, Apple Pay,
# Google Pay) embeds directly in the Order/Catering pages using this;
# without it, checkout stays in test mode with no payment UI shown.
STRIPE_PUBLISHABLE_KEY=

# Twilio — turns on real "order received" text messages.
# https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend — turns on real order-receipt and catering-followup emails.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@clesmashburgers.com

# Clover — pushes paid orders/catering bookings into your restaurant's
# Clover account so staff see them on the register/KDS and a kitchen
# ticket can print. Get both from dashboard.clover.com under
# Setup > API Tokens (generating a token there also shows your
# Merchant ID). Leave blank and orders just aren't pushed — customers
# still get their normal confirmation either way.
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
# Set to "true" to test against Clover's sandbox instead of your real
# live account while you're getting this set up.
CLOVER_SANDBOX=

# Kitchen dashboard passcode (protects /#/kitchen). Leave this blank while
# you're just testing locally — the board will be open with no login.
# Set a real value before this app is reachable from outside your machine.
KITCHEN_PASSWORD=

PORT=3000
